DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/evadvisor
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External EV Catalog Data API (e.g., API Ninjas)
EV_CATALOG_API_KEY=your_api_key_here
EV_CATALOG_API_URL=https://api.api-ninjas.com/v1/electricvehicle
# Bundled OpenEV Data dataset (primary, offline EV catalog). Update with
# `python backend/scripts/update_ev_dataset.py`.
EV_DATASET_PATH=data/open-ev-data.csv

# Conventional (ICE) car catalog — free-tier API Ninjas endpoints.
# CAR_CATALOG_API_KEY falls back to EV_CATALOG_API_KEY when empty.
CAR_CATALOG_API_KEY=
CAR_FACETS_API_URL=https://api.api-ninjas.com/v2/carfacets
CAR_CATALOG_API_URL=https://api.api-ninjas.com/v1/cars

# Used-car valuation via RapidAPI's "AutoScout24 Scraper" (scrapeunblocker).
# Key from https://rapidapi.com — used only for the on-demand "Stima valore" button.
RAPIDAPI_API_KEY=
RAPIDAPI_AS24_URL=https://autoscout24-scraper.p.rapidapi.com/get_page_source
AUTOSCOUT24_BASE_URL=https://www.autoscout24.it

